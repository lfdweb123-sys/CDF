# -----------------------------------------------------------------------------
# Firebase — client SDK (public, safe to expose in the browser bundle; access
# control is enforced by Firestore security rules, not by hiding these).
# No Firebase Storage bucket needed — this app doesn't use Firebase Storage,
# see src/lib/file-upload.ts.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of this deployment (used in emails and canonical/OG metadata)
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# -----------------------------------------------------------------------------
# Firebase — Admin SDK (SECRET — server-side only, never exposed to the browser)
# From your Firebase service account JSON: project_id / client_email / private_key
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escape sequences as a single-line, double-quoted value
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Brevo (transactional email) — https://app.brevo.com/settings/keys/api
# -----------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@your-domain.com
BREVO_SENDER_NAME=CDF — Cabinet de Contrôle Opérationnel

# -----------------------------------------------------------------------------
# One-time bootstrap of the very first SUPER_ADMIN_CDF account, entirely
# through the deployed site at /amorcage-admin (no local script needed).
# Generate a long random value, set it here, use it once, then delete this
# env var from your hosting provider (the route also self-disables once a
# SUPER_ADMIN_CDF account exists — see src/app/api/setup/bootstrap-admin).
# -----------------------------------------------------------------------------
ADMIN_SETUP_TOKEN=
